  "components": {
    "schemas": {
      "Approval": {
        "properties": {
          "comment": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 5,
            "title": "Comment"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "comment"
        ],
        "title": "Approval"
      },
      "ConfigurationInput": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name"
          },
          "version": {
            "type": "string",
            "maxLength": 40,
            "minLength": 1,
            "title": "Version"
          },
          "threshold": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Threshold",
            "default": 1.0
          },
          "require_llm": {
            "type": "boolean",
            "title": "Require Llm",
            "default": false
          },
          "rubric": {
            "type": "string",
            "maxLength": 5000,
            "title": "Rubric",
            "default": "Check whether the answer is supported by the provided context. Pass only grounded answers."
          },
          "rubric_version": {
            "type": "string",
            "title": "Rubric Version",
            "default": "grounding-v1"
          },
          "provider": {
            "type": "string",
            "enum": [
              "openai",
              "gemini"
            ],
            "title": "Provider",
            "default": "openai"
          },
          "model": {
            "type": "string",
            "maxLength": 100,
            "title": "Model",
            "default": "gpt-4.1-mini"
          },
          "price_per_million_tokens": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Price Per Million Tokens"
          },
          "price_date": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Price Date"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "version"
        ],
        "title": "ConfigurationInput"
      },
      "DatasetImport": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name"
          },
          "version": {
            "type": "string",
            "maxLength": 40,
            "minLength": 1,
            "title": "Version"
          },
          "format": {
            "type": "string",
            "enum": [
              "json",
              "jsonl"
            ],
            "title": "Format"
          },
          "content": {
            "type": "string",
            "maxLength": 2000000,
            "title": "Content"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "version",
          "format",
          "content"
        ],
        "title": "DatasetImport"
      },
      "EndpointInput": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name"
          },
          "url": {
            "type": "string",
            "maxLength": 2000,
            "title": "Url"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "url"
        ],
        "title": "EndpointInput"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HumanReview": {
        "properties": {
          "case_id": {
            "type": "string",
            "title": "Case Id"
          },
          "verdict": {
            "type": "string",
            "enum": [
              "pass",
              "fail"
            ],
            "title": "Verdict"
          },
          "comment": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 5,
            "title": "Comment"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "case_id",
          "verdict",
          "comment"
        ],
        "title": "HumanReview"
      },
      "JobInput": {
        "properties": {
          "dataset_id": {
            "type": "string",
            "title": "Dataset Id"
          },
          "configuration_id": {
            "type": "string",
            "title": "Configuration Id"
          },
          "label": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Label"
          },
          "source": {
            "type": "string",
            "enum": [
              "fixture",
              "api",
              "endpoint"
            ],
            "title": "Source",
            "default": "fixture"
          },
          "fixture": {
            "type": "string",
            "enum": [
              "reference",
              "regression"
            ],
            "title": "Fixture",
            "default": "reference"
          },
          "endpoint_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Endpoint Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "dataset_id",
          "configuration_id",
          "label"
        ],
        "title": "JobInput"
      },
      "Login": {
        "properties": {
          "username": {
            "type": "string",
            "title": "Username"
          },
          "password": {
            "type": "string",
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "Login"
      },
      "ResultsImport": {
        "properties": {
          "dataset_id": {
            "type": "string",
            "title": "Dataset Id"
          },
          "configuration_id": {
            "type": "string",
            "title": "Configuration Id"
          },
          "label": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Label"
          },
          "format": {
            "type": "string",
            "enum": [
              "json",
              "jsonl"
            ],
            "title": "Format"
          },
          "content": {
            "type": "string",
            "maxLength": 2000000,
            "title": "Content"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "dataset_id",
          "configuration_id",
          "label",
          "format",
          "content"
        ],
        "title": "ResultsImport"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
