APP_MODE=DEMO
PUBLIC_ORIGIN=http://localhost:3103
COOKIE_SECURE=false
MODEL_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
# LIVE: JSON mapping usernames to {role, password_hash}; generate hash with the provision command.
# In .env, single-quote the entire JSON value to preserve dollar signs in scrypt hashes.
LIVE_USERS_JSON={}
ENDPOINT_ALLOWED_HOSTS=
MODEL_CONCURRENCY=2
OTEL_CONSOLE=false
MODEL_TIMEOUT_SECONDS=25
MODEL_MAX_OUTPUT_TOKENS=1500
MODEL_MAX_RETRIES=1
